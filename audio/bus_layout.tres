[gd_resource type="AudioBusLayout" load_steps=5 format=3]

[sub_resource type="AudioEffectHighPassFilter" id="AudioEffectHighPassFilter_1"]
resource_name = "HighPassFilter"
cutoff_hz = 220.0

[sub_resource type="AudioEffectLowPassFilter" id="AudioEffectLowPassFilter_1"]
resource_name = "LowPassFilter"
cutoff_hz = 4800.0

[sub_resource type="AudioEffectStereoEnhance" id="AudioEffectStereoEnhance_1"]
resource_name = "StereoEnhance"
pan_pullout = 0.25

[sub_resource type="AudioEffectCompressor" id="AudioEffectCompressor_1"]
resource_name = "Compressor"
threshold = -12.0
ratio = 3.0

[resource]
bus/0/effect/0/effect = SubResource("AudioEffectHighPassFilter_1")
bus/0/effect/0/enabled = true
bus/0/effect/1/effect = SubResource("AudioEffectLowPassFilter_1")
bus/0/effect/1/enabled = true
bus/0/effect/2/effect = SubResource("AudioEffectStereoEnhance_1")
bus/0/effect/2/enabled = true
bus/0/effect/3/effect = SubResource("AudioEffectCompressor_1")
bus/0/effect/3/enabled = true
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
bus/3/name = &"Voice"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"Master"
