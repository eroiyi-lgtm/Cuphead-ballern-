; Engine configuration file.
; Project Inkwell – Level 1 "Das Schreibtisch-Duell" (Phase 2: Graybox)

config_version=5

[application]

config/name="Project Inkwell"
config/description="Level 1 – Das Schreibtisch-Duell (Phase-2-Graybox)"
run/main_scene="res://main/main.tscn"
config/icon="res://art/icon.svg"
config/features=PackedStringArray("4.3", "Mobile")

[audio]

buses/default_bus_layout="res://audio/bus_layout.tres"

[autoload]

Events="*res://autoload/events.gd"
SaveData="*res://autoload/save_data.gd"
InputRouter="*res://autoload/input_router.gd"
AudioDirector="*res://autoload/audio_director.gd"
Game="*res://autoload/game.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="Welt"
2d_physics/layer_2="Pete-Hurtbox"
2d_physics/layer_3="Pete-Geschosse"
2d_physics/layer_4="Gegner-Hurtbox"
2d_physics/layer_5="Gegner-Geschosse"
2d_physics/layer_6="Parry"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.913725, 0.862745, 0.752941, 1)
